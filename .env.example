# Supabase project settings (server and browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# For local development, use Ollama installed on this laptop.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# Only needed when using cloud embeddings (for example, the Vercel deployment).
OPENAI_API_KEY=

# DataByte AI Gateway is used for draft generation. Never use NEXT_PUBLIC_ here.
DATABYTE_BASE_URL=https://ai.databyte.co.id/v1
DATABYTE_API_KEY=
DATABYTE_MODEL=MiniMax-M3
DATABYTE_MAX_TOKENS=8192

# Set a long random value and configure the matching Vercel Cron secret.
CRON_SECRET=
